# Tesseract executable path (Windows example)
# TESSERACT_CMD=C:\\Program Files\\Tesseract-OCR\\tesseract.exe
TESSERACT_LANG=eng
TESSERACT_PSM=3

# Optional AI provider. Gemini powers handwriting recognition, document Q&A,
# summaries, and the general assistant. Keep the real key in .env.
SMARTOCR_AI_PROVIDER=gemini
GEMINI_API_KEY=
SMARTOCR_AI_MODEL=gemini-3.8-flash

# Optional OpenAI-compatible provider. Leave blank when using Gemini.
SMARTOCR_AI_API_BASE_URL=
SMARTOCR_AI_API_KEY=

# Optional translation-compatible service
SMARTOCR_TRANSLATION_URL=
SMARTOCR_TRANSLATION_API_KEY=

# Optional TrOCR handwriting model. Requires compatible torch + transformers.
SMARTOCR_ENABLE_TROCR=0
SMARTOCR_TROCR_MODEL=microsoft/trocr-base-handwritten

